{
  "name": "@gravity-ui/normalized-list",
  "version": "0.0.1",
  "description": "",
  "license": "MIT",
  "main": "./build/cjs/index.js",
  "module": "./build/esm/index.js",
  "types": "./build/esm/index.d.ts",
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "files": [
    "build"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./build/esm/index.d.ts",
        "default": "./build/esm/index.js"
      },
      "require": {
        "types": "./build/cjs/index.d.ts",
        "default": "./build/cjs/index.js"
      }
    },
    "./uikit": {
      "import": {
        "types": "./build/esm/uikit/index.d.ts",
        "default": "./build/esm/uikit/index.js"
      },
      "require": {
        "types": "./build/cjs/uikit/index.d.ts",
        "default": "./build/cjs/uikit/index.js"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gravity-ui/normalized-list.git"
  },
  "bugs": {
    "url": "https://github.com/gravity-ui/normalized-list/issues"
  },
  "homepage": "https://github.com/gravity-ui/normalized-list#readme",
  "scripts": {
    "prepare": "husky",
    "lint:js": "eslint",
    "lint:styles": "stylelint 'src/**/*.scss'",
    "lint": "run-p lint:*",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "build": "gulp",
    "clean": "gulp clean",
    "start": "TS_NODE_PROJECT=.storybook/tsconfig.json storybook dev",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@bem-react/classname": "^1.7.0",
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@faker-js/faker": "^9.8.0",
    "@floating-ui/react": "^0.27.20",
    "@gravity-ui/eslint-config": "^4.2.0",
    "@gravity-ui/gulp-utils": "^1.0.3",
    "@gravity-ui/icons": "^2.16.0",
    "@gravity-ui/prettier-config": "^1.1.0",
    "@gravity-ui/stylelint-config": "^5.0.0",
    "@gravity-ui/tsconfig": "^1.0.0",
    "@gravity-ui/uikit": "^7.25.0",
    "@hello-pangea/dnd": "^18.0.1",
    "@storybook/addon-docs": "^9.0.5",
    "@storybook/addon-styling-webpack": "^2.0.0",
    "@storybook/addon-webpack5-compiler-babel": "^3.0.6",
    "@storybook/react-webpack5": "^9.0.5",
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4.17.24",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@types/react-window": "^1.8.8",
    "css-loader": "^7.1.2",
    "eslint": "^9.38.0",
    "globals": "^16.4.0",
    "gulp": "^5.0.1",
    "gulp-cli": "^3.1.0",
    "gulp-sass": "^6.0.1",
    "gulp-sourcemaps": "^3.0.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-transform-css": "^6.0.3",
    "nano-staged": "^0.8.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-virtualized-auto-sizer": "^1.0.26",
    "react-window": "^1.8.11",
    "rimraf": "^6.0.1",
    "sass": "^1.93.2",
    "sass-loader": "^16.0.5",
    "storybook": "^9.0.5",
    "style-loader": "^3.3.4",
    "stylelint": "^16.25.0",
    "ts-jest": "^29.4.5",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@floating-ui/react": "^0.27.0",
    "@gravity-ui/icons": "^2.16.0",
    "@gravity-ui/uikit": "^7.25.0",
    "react": "^16.14.0 || ^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^16.14.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@floating-ui/react": {
      "optional": true
    },
    "@gravity-ui/icons": {
      "optional": true
    },
    "@gravity-ui/uikit": {
      "optional": true
    }
  },
  "nano-staged": {
    "*.{scss}": [
      "stylelint --fix --quiet"
    ],
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix --quiet"
    ],
    "*.md": [
      "prettier --write"
    ]
  }
}
